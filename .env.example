# Public project URL. Dashboard: https://supabase.com/dashboard/project/ybmseuuumwiyudwqvzuh
SUPABASE_URL=https://ybmseuuumwiyudwqvzuh.supabase.co
# Publishable browser key (sb_publishable_...). Preferred over the legacy anon JWT.
# Set these in the Netlify UI. Do not commit a real key. Do not put a secret or
# service-role key in any variable this site serves to the browser.
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT whose role is "anon". Used only when SUPABASE_PUBLISHABLE_KEY is empty.
SUPABASE_ANON_KEY=
